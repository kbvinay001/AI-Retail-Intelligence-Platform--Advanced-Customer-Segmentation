# ─── AI Retail Intelligence Platform V3.0 — Environment Config ────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Application ─────────────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=production
LOG_LEVEL=INFO

# ─── Security (CHANGE THESE IN PRODUCTION) ───────────────────────────────────
SECRET_KEY=ai-retail-v3-super-secret-key-change-in-prod-2024
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── API Server ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── OpenAI (Optional — enables GPT-4 recommendations) ──────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/retail_intelligence.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/retail_db

# ─── Redis (Optional — enables caching & Celery) ─────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Email Notifications ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM=alerts@retail-intelligence.ai

# ─── Multi-store ─────────────────────────────────────────────────────────────
MAX_STORES_PER_TENANT=50
STORE_TIMEZONE=Asia/Kolkata
RATE_LIMIT_PER_MINUTE=60
